      "up": "CREATE OR REPLACE VIEW kiln_reporting_v1.testimonials WITH (security_barrier = true) AS SELECT t.id, t.org_id, t.title, t.slug, t.locale, t.audience, t.state, t.published_at, t.inserted_at, t.updated_at, COALESCE(cf.allowed, '{}'::jsonb) AS custom_fields FROM testimonials t LEFT JOIN LATERAL (SELECT jsonb_object_agg(fd.name, CASE WHEN jsonb_typeof(val.v) = 'object' THEN CASE WHEN jsonb_typeof(val.v) = 'object' AND (fd.field_type::text = 'reference' OR (val.v ?& ARRAY['id', 'type', 'slug', 'title'] AND NOT val.v ? 'url')) THEN jsonb_build_object('id', val.v -> 'id', 'type', val.v -> 'type') ELSE val.v END WHEN jsonb_typeof(val.v) = 'array' AND (fd.field_type::text = 'reference' OR val.v @? '$[*].slug') THEN COALESCE((SELECT jsonb_agg(CASE WHEN jsonb_typeof(e.x) = 'object' AND (fd.field_type::text = 'reference' OR (e.x ?& ARRAY['id', 'type', 'slug', 'title'] AND NOT e.x ? 'url')) THEN jsonb_build_object('id', e.x -> 'id', 'type', e.x -> 'type') ELSE e.x END ORDER BY e.n) FROM jsonb_array_elements(val.v) WITH ORDINALITY AS e(x, n)), '[]'::jsonb) ELSE val.v END) AS allowed FROM field_definitions fd CROSS JOIN LATERAL (SELECT t.custom_fields -> fd.name AS v) val WHERE fd.name = ANY (ARRAY(SELECT jsonb_object_keys(CASE WHEN jsonb_typeof(t.custom_fields) = 'object' THEN t.custom_fields ELSE '{}'::jsonb END))) AND fd.org_id = t.org_id AND fd.type_definition_id IS NULL AND fd.content_type = 'testimonial' AND fd.private = false AND fd.field_type <> 'user' AND fd.link_of_id IS NULL AND fd.group_of_id IS NULL) cf ON true WHERE t.state = 'published' AND t.archived_at IS NULL AND t.access_password_hash IS NULL AND t.audience = 'public'"
