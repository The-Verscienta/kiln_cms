# Kiln preset: minimal — the console and delivery, nothing that calls out.
# Layer on .env.prod (DATABASE_URL, SECRET_KEY_BASE, PHX_HOST, TRUSTED_PROXIES).
# Image: ghcr.io/the-verscienta/kiln_cms:<version>

# Media on a mounted volume, so a redeploy keeps uploads.
KILN_MEDIA_ROOT=/app/media

# In-app backups to the default directory; mount it too.
BACKUP_ENABLED=true

# Nothing leaves the deployment: no mail, no embeds, no metrics listener.
# Invitations and password resets queue until MAIL_MODE is set.
# MAIL_MODE=
OEMBED_ENABLED=false
KILN_METRICS_ENABLED=false
KILN_FEDERATION_ENABLED=false
KILN_EXPERIMENTS_ENABLED=false
KILN_PROVENANCE_ENABLED=false

# Kept on: the signed history anchors cost nothing and are hard to add later.
KILN_AUDIT_ANCHORS_ENABLED=true
VISUAL_EDITING_ENABLED=true
