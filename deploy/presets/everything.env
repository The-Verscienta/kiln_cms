# Kiln preset: everything — publishing plus every optional subsystem.
# Layer on .env.prod (DATABASE_URL, SECRET_KEY_BASE, PHX_HOST, TRUSTED_PROXIES).
# Image: ghcr.io/the-verscienta/kiln_cms:<version>-ml (the ML build; the
# lean image runs this preset too, with reranking and semantic search off).
# Compose: --profile storage --profile search

MAIL_MODE=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM_EMAIL=

# Object storage behind a CDN (the storage profile runs MinIO locally).
# S3_BUCKET=
# S3_PUBLIC_BASE_URL=
# AWS_REGION=auto
# CSP_IMG_SRC=
# KILN_CDN_PURGE_URL=
# KILN_CDN_PURGE_TOKEN=

OEMBED_ENABLED=true
KILN_AUDIT_ANCHORS_ENABLED=true
KILN_PROVENANCE_ENABLED=true
# KILN_PROVENANCE_KEY_FILE=/run/secrets/kiln-provenance.pem

# Meilisearch as the search backend (the search profile). Setting the URL
# enables it; Postgres full-text stays the fallback.
# MEILI_URL=http://meilisearch:7700
# MEILI_MASTER_KEY=

# Distribution and experiments.
KILN_FEDERATION_ENABLED=true
KILN_EXPERIMENTS_ENABLED=true

# Observability: Prometheus listener, Sentry, OpenTelemetry.
KILN_METRICS_ENABLED=true
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=

# LLM assistants (SEO, assist, ask). Name a model; req_llm reads the
# provider's own API key variable (ANTHROPIC_API_KEY, OPENAI_API_KEY, ...).
# SEO_MODEL=anthropic:claude-haiku-5-5
# ASSIST_MODEL=anthropic:claude-haiku-5-5
# ASK_MODEL=anthropic:claude-haiku-5-5

# Reranking needs the -ml image; on the lean image it is refused with a
# NotCompiledError and search falls back to its keyword legs.
ASK_RERANK=true

# Semantic search has no environment variable yet: it is
# `config :kiln_cms, KilnCMS.Search, semantic: true` in a project overlay,
# and needs the -ml image. Tracked in #1932.

BACKUP_ENABLED=true
VISUAL_EDITING_ENABLED=true
