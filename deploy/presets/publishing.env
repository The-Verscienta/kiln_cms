# Kiln preset: publishing — a public site with mail, embeds and a signed record.
# Layer on .env.prod (DATABASE_URL, SECRET_KEY_BASE, PHX_HOST, TRUSTED_PROXIES).
# Image: ghcr.io/the-verscienta/kiln_cms:<version>

# Mail over a relay. Fill the SMTP_* lines from the provider's dashboard
# (587 STARTTLS; 465 does not work). MAIL_MODE=direct is the built-in MTA
# and needs outbound port 25, which most clouds block.
MAIL_MODE=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM_EMAIL=

# Media: a volume, or S3-compatible storage behind a CDN. Set one.
KILN_MEDIA_ROOT=/app/media
# S3_BUCKET=
# S3_PUBLIC_BASE_URL=
# AWS_REGION=auto
# CSP_IMG_SRC=https://media.example.com

# Embeds render as cards.
OEMBED_ENABLED=true

# The record: signed anchors on, and every fired artifact carries a
# provenance manifest. Generate the key once; see docs/provenance.md.
KILN_AUDIT_ANCHORS_ENABLED=true
KILN_PROVENANCE_ENABLED=true
# KILN_PROVENANCE_KEY_FILE=/run/secrets/kiln-provenance.pem

# Purge the CDN on publish. Leave unset without a CDN.
# KILN_CDN_PURGE_URL=
# KILN_CDN_PURGE_TOKEN=

# Error tracking; also the only sink for boot-time config warnings.
# SENTRY_DSN=

BACKUP_ENABLED=true
VISUAL_EDITING_ENABLED=true
KILN_METRICS_ENABLED=false
KILN_FEDERATION_ENABLED=false
KILN_EXPERIMENTS_ENABLED=false
