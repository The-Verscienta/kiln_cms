#!/usr/bin/env bash
# Regenerate Sources/KilnModels/Kiln.swift.
#
# Runs the regenerator test in the Kiln checkout this example lives in (two
# directories up). It creates the `recipe` type (kiln/recipe_type.exs, the
# definition the demo seed uses) in the test database and writes the export
# for it with the core blocks only, so it needs no seeded dev database and
# writes the same bytes the drift test
# (test/kiln_cms/schema_export/swiftui_reader_drift_test.exs) expects.
#
#   bin/regenerate
set -euo pipefail

here="$(cd "$(dirname "$0")/.." && pwd)"
kiln="$(cd "$here/../.." && pwd)"

cd "$kiln"
mix test --only regenerate_swiftui_models \
  test/kiln_cms/schema_export/regenerate_swiftui_reader_test.exs
echo "Wrote ${here#"$kiln"/}/Sources/KilnModels/Kiln.swift"
