    "ingredients": [
      {
        "amount": 200.0,
        "item": "Plain flour",
        "unit": "g"
      },
      {
        "amount": 300.0,
        "item": "Buttermilk",
        "unit": "ml"
      },
      {
        "amount": 2.0,
        "item": "Eggs",
        "unit": "pcs"
      },
      {
        "amount": 2.0,
        "item": "Baking powder",
        "unit": "tsp"
      },
      {
        "amount": 2.0,
        "item": "Melted butter",
        "unit": "tbsp"
      }
    ],
    "method": "<h2>Batter</h2>\n<ol><li>Whisk the <strong>flour</strong> and baking powder.</li>\n<li>Beat in the eggs, buttermilk and butter until <em>just</em> smooth.</li></ol>\n<h2>Cook</h2>\n<p>Ladle onto a hot pan. Flip when bubbles <em>stop</em> popping \u2014 about <code>2 min</code> a side.</p>\n<blockquote>Lumps are fine; overmixing is not.</blockquote>\n<p>More in <a href=\"https://kilncms.dev\">the Kiln docs</a>.</p>",
    "minutes": 25,
    "serves": 4
  },
