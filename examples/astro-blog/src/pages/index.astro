---
import Base from "../layouts/Base.astro";
import { publishedDocuments } from "../lib/kiln";

// The index renders from the same memoized document set `getStaticPaths`
// builds routes from, so every link here points at a page that was actually
// generated — a ref whose artifact fetch missed is absent from both.
const entries = await publishedDocuments();

// Posts first, then pages, alphabetical within each.
const order: Record<string, number> = { post: 0, page: 1 };
const sorted = entries.slice().sort((a, b) => {
  const byType = (order[a.ref.type] ?? 9) - (order[b.ref.type] ?? 9);
  return byType !== 0 ? byType : a.ref.title.localeCompare(b.ref.title);
});
---

<Base title="Kiln Blog">
  <h1>Latest content</h1>

  {sorted.length === 0 && (
    <p>
      No published content found. Start KilnCMS, seed it
      (<code>mix run priv/repo/seeds.exs</code>), then rebuild.
    </p>
  )}

  <ul class="post-list">
    {sorted.map(({ ref }) => (
      <li>
        <span class="type">{ref.type}</span>
        <div>
          <a href={`/${ref.type}/${ref.slug}`}>{ref.title}</a>
        </div>
      </li>
    ))}
  </ul>
</Base>
