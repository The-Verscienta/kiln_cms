---
import Base from "../layouts/Base.astro";
import { discoverContent } from "../lib/kiln";

// Enumerate every published document from the JSON:API published feeds —
// metadata only (slug + title), one request per content type. No artifact
// fetches needed here: the block bodies are only pulled for the detail pages.
const refs = await discoverContent();

// Posts first, then pages, alphabetical within each.
const order: Record<string, number> = { post: 0, page: 1 };
const entries = refs.slice().sort((a, b) => {
  const byType = (order[a.type] ?? 9) - (order[b.type] ?? 9);
  return byType !== 0 ? byType : a.title.localeCompare(b.title);
});
---

<Base title="Kiln Blog">
  <h1>Latest content</h1>

  {entries.length === 0 && (
    <p>
      No published content found. Start KilnCMS, seed it
      (<code>mix run priv/repo/seeds.exs</code>), then rebuild.
    </p>
  )}

  <ul class="post-list">
    {entries.map((ref) => (
      <li>
        <span class="type">{ref.type}</span>
        <div>
          <a href={`/${ref.type}/${ref.slug}`}>{ref.title}</a>
        </div>
      </li>
    ))}
  </ul>
</Base>
