---
import Base from "../../layouts/Base.astro";
import { publishedDocuments, type Document } from "../../lib/kiln";
import { renderBlocks } from "../../lib/render";

// Static generation: one page per published document. The refs and their
// fired artifacts come from the same memoized set the index renders from
// (discovery is paginated and locale-filtered there; a cold artifact cache's
// 503 is retried once by the client), so index links and generated routes
// cannot disagree.
export async function getStaticPaths() {
  const entries = await publishedDocuments();

  return entries.map(({ ref, doc }) => ({
    params: { type: ref.type, slug: ref.slug },
    props: { doc },
  }));
}

interface Props {
  doc: Document;
}
const { doc } = Astro.props as Props;
const html = renderBlocks(doc.blocks);
---

<Base title={doc.title}>
  <article>
    <h1>{doc.title}</h1>
    <Fragment set:html={html} />
  </article>
  <p style="margin-top:2rem"><a href="/">← Back to all content</a></p>
</Base>
