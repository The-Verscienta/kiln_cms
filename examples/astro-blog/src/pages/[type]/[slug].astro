---
import { isKilnHttpError } from "@kiln-cms/client";
import Base from "../../layouts/Base.astro";
import { discoverContent, kiln, LOCALE, type Document } from "../../lib/kiln";
import { renderBlocks } from "../../lib/render";

// Static generation: one page per published document from the JSON:API feeds.
// Each document's fired artifact (`?surface=json`) is fetched here so every
// route ships as plain pre-rendered HTML. A cold artifact cache answers 503;
// the client retries that once on its own.
export async function getStaticPaths() {
  const refs = await discoverContent();

  const pages = await Promise.all(
    refs.map(async (ref) => {
      try {
        const doc = await kiln.artifact<Document>(ref.type, ref.slug, { locale: LOCALE });
        return { params: { type: ref.type, slug: ref.slug }, props: { doc } };
      } catch (error) {
        // Listed but not servable (e.g. unpublished mid-build): skip the page
        // rather than failing the whole build.
        if (isKilnHttpError(error) && error.status === 404) return null;
        throw error;
      }
    }),
  );

  return pages.filter((page): page is NonNullable<typeof page> => page !== null);
}

interface Props {
  doc: Document;
}
const { doc } = Astro.props as Props;
const html = renderBlocks(doc.blocks);
---

<Base title={doc.title}>
  <article>
    <h1>{doc.title}</h1>
    <Fragment set:html={html} />
  </article>
  <p style="margin-top:2rem"><a href="/">← Back to all content</a></p>
</Base>
