<!DOCTYPE html>
<html lang={assigns[:locale] || "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <%!-- White-label branding (#48). `assigns[:current_org]` (not `@current_org`):
          the plug assigns it on every request, but the `:authenticated_routes`
          live session has no `:assign_current_org` on_mount, and
          `Branding.for_org(nil)` correctly resolves the default org. --%>
    <.live_title
      default={Layouts.brand_name(assigns[:current_org])}
      suffix={" · " <> Layouts.brand_name(assigns[:current_org])}
      phx-no-format
    >{assigns[:page_title]}</.live_title>
    <link rel="icon" href={KilnCMS.Branding.for_org(assigns[:current_org]).favicon_url} />
    <%!-- Installable editor PWA (#65). `assigns[:pwa]` is set by the
          `:live_editor_required` / `:live_admin_required` on_mount hooks, so
          these tags appear on authoring pages ONLY — a public reader is never
          offered an install prompt for the admin app, and app.js keys service
          worker registration off this same manifest link. --%>
    <link :if={assigns[:pwa]} rel="manifest" href={~p"/manifest.webmanifest"} />
    <%!-- iOS ignores the manifest: standalone mode, the home-screen name and the
          icon are all `<meta>`/`<link>`-driven there.

          No `apple-mobile-web-app-status-bar-style`. The interesting value,
          `black-translucent`, makes the web view full-bleed and lets the status
          bar OVERLAY the page — which needs `viewport-fit=cover` plus
          `env(safe-area-inset-top)` padding throughout, or the editor's header
          sits under the notch. Omitting the tag keeps iOS's default opaque bar
          with content laid out below it, which is correct with no layout work.
          Revisit alongside safe-area padding, not before. --%>
    <meta :if={assigns[:pwa]} name="mobile-web-app-capable" content="yes" />
    <meta :if={assigns[:pwa]} name="apple-mobile-web-app-capable" content="yes" />
    <meta
      :if={assigns[:pwa]}
      name="apple-mobile-web-app-title"
      content={Layouts.brand_name(assigns[:current_org])}
    />
    <link :if={assigns[:pwa]} rel="apple-touch-icon" href={~p"/images/apple-touch-icon.png"} />
    <meta :if={assigns[:meta_description]} name="description" content={@meta_description} />
    <meta :if={assigns[:meta_keywords]} name="keywords" content={@meta_keywords} />
    <link :if={assigns[:canonical_url]} rel="canonical" href={@canonical_url} />
    <meta :if={assigns[:page_title]} property="og:title" content={@page_title} />
    <meta :if={assigns[:meta_description]} property="og:description" content={@meta_description} />
    <meta :if={assigns[:og_image]} property="og:image" content={@og_image} />
    <meta property="og:type" content={assigns[:og_type] || "website"} />
    <meta :if={assigns[:locale]} property="og:locale" content={@locale} />
    <meta :if={assigns[:canonical_url]} property="og:url" content={@canonical_url} />
    <%!-- Other published locales as og:locale:alternate (#164). --%>
    <meta
      :for={alt <- assigns[:hreflang] || []}
      :if={alt.hreflang not in ["x-default", assigns[:locale]]}
      property="og:locale:alternate"
      content={alt.hreflang}
    />
    <%!-- Twitter Card (#164): falls back to the Open Graph values above. --%>
    <meta
      name="twitter:card"
      content={(assigns[:og_image] && "summary_large_image") || "summary"}
    />
    <meta :if={assigns[:page_title]} name="twitter:title" content={@page_title} />
    <meta :if={assigns[:meta_description]} name="twitter:description" content={@meta_description} />
    <meta :if={assigns[:og_image]} name="twitter:image" content={@og_image} />
    <link
      :for={alt <- assigns[:hreflang] || []}
      rel="alternate"
      hreflang={alt.hreflang}
      href={alt.href}
    />
    {assigns[:json_ld]}
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <%!-- Per-org brand tokens (#48). MUST come after the stylesheet link, and the
          component MUST emit both the :root and the [data-theme="dark"] rule —
          these declarations are unlayered, so they outrank both `@layer theme`
          and `@layer base`, and a :root-only override would silently flatten
          dark mode. Emits nothing for an unbranded site. --%>
    <Layouts.brand_tokens org={assigns[:current_org]} />
    <%!-- type="module": the bundle is ESM (esbuild --splitting) so the TipTap
          editor chunk loads on demand in the admin editor only. --%>
    <script defer phx-track-static type="module" src={~p"/assets/js/app.js"}>
    </script>
    <script nonce={assigns[:csp_nonce]}>
      (() => {
        const systemTheme = () => matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.setAttribute("data-theme", systemTheme());
            document.documentElement.setAttribute("data-theme-source", "system");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
            document.documentElement.setAttribute("data-theme-source", "user");
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));

        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
          if (document.documentElement.getAttribute("data-theme-source") === "system") {
            document.documentElement.setAttribute("data-theme", systemTheme());
          }
        });
      })();
    </script>
  </head>
  <body>
    <%!-- Skip link (#175): first focusable element, visually hidden until
          focused, jumps keyboard users past the header to <main id="main">. --%>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-base-100 focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-base-content focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-primary"
    >
      {gettext("Skip to main content")}
    </a>
    {@inner_content}
  </body>
</html>
