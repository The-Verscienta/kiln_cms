<div class="auth-page">
  <div class="auth-card py-12">
    <%!-- An h2: `Layouts.auth/1` draws the page's one (sr-only) h1 from this
          same title (#2162). --%>
    <h2 class="auth-title mb-2">{gettext("Two-factor authentication")}</h2>
    <%!-- With a passkey too, the hint is shipped `hidden` and revealed with
          the passkey button by `initPasskeyStepUp`, so it never offers a
          passkey the browser cannot use. One `#two-factor-help`: the code
          field's `aria-describedby` names it. --%>
    <p :if={@code?} id="two-factor-help" class="auth-muted mb-6">
      {gettext("Enter the 6-digit code from your authenticator app.")}
      <span :if={@passkey?} id="two-factor-passkey-hint" data-passkey-step-up-hint hidden>
        {gettext("You can also use a passkey.")}
      </span>
    </p>
    <p :if={!@code? && @passkey?} id="two-factor-help" class="auth-muted mb-6">
      {gettext("Confirm it's you with your passkey.")}
    </p>
    <p :if={!@code? && !@passkey?} id="two-factor-help" class="auth-muted mb-6">
      {gettext("This sign-in can't be finished here. Start again.")}
    </p>

    <%!-- `role="alert"` so a refused code is announced the moment the page
          lands, and referenced from the field's `aria-describedby` so it is
          read again when focus returns to the input. --%>
    <p :if={@error} id="two-factor-error" role="alert" class="mb-4 text-sm text-error">
      {@error}
    </p>

    <.form :if={@code?} for={%{}} id="two-factor-form" action={~p"/sign-in/verify"} method="post">
      <label for="two-factor-code" class="field-label">
        {gettext("Authentication code")}
      </label>
      <input
        id="two-factor-code"
        name="code"
        type="text"
        class="field-input text-center text-lg tracking-[0.3em]"
        autocomplete="one-time-code"
        inputmode="numeric"
        maxlength="12"
        required
        autofocus={!@recovery?}
        aria-invalid={@error && !@recovery? && "true"}
        aria-describedby={
          described_by(["two-factor-help", @error && !@recovery? && "two-factor-error"])
        }
      />
      <button type="submit" class="btn btn-primary btn-block mt-4">
        {gettext("Verify")}
      </button>
    </.form>

    <%!-- No script: a native disclosure, opened on the way back from a refused
          recovery code so the user lands where they were typing. --%>
    <details :if={@code?} id="two-factor-recovery" class="mt-6" open={@recovery?}>
      <summary class="link text-sm font-medium text-base-content">
        {gettext("Use a recovery code instead")}
      </summary>

      <.form
        for={%{}}
        id="two-factor-recovery-form"
        action={~p"/sign-in/verify"}
        method="post"
        class="mt-4"
      >
        <input type="hidden" name="factor" value="recovery" />
        <label for="two-factor-recovery-code" class="field-label">
          {gettext("Recovery code")}
        </label>
        <input
          id="two-factor-recovery-code"
          name="code"
          type="text"
          class="field-input font-mono uppercase tracking-widest"
          autocomplete="off"
          autocapitalize="characters"
          spellcheck="false"
          maxlength="12"
          required
          autofocus={@recovery?}
          aria-invalid={@error && @recovery? && "true"}
          aria-describedby={
            described_by(["two-factor-recovery-help", @error && @recovery? && "two-factor-error"])
          }
        />
        <p id="two-factor-recovery-help" class="auth-muted mt-1">
          {gettext("One of the codes you saved when you turned on two-factor authentication.")}
        </p>
        <button type="submit" class="btn btn-default btn-block mt-4">
          {gettext("Verify recovery code")}
        </button>
      </.form>
    </details>

    <%!-- The passkey option (#2247): rendered only for an account that has
          one, on a host where the ceremony can run, and shipped `hidden` —
          `initPasskeyStepUp` (assets/js/passkeys.js) reveals it where WebAuthn
          exists, so a browser without it never sees a button that cannot
          work. Wired from app.js on load; no script here, so this page's CSP
          is unchanged. --%>
    <div :if={@passkey?} id="two-factor-passkey" class="mt-6" data-passkey-step-up hidden>
      <button type="button" class="btn btn-default btn-block" data-role="passkey-step-up">
        <.icon name="hero-key" class="size-4" />
        {gettext("Use a passkey")}
      </button>
      <p
        class="auth-muted mt-2 text-center text-xs"
        role="status"
        data-role="passkey-status"
        data-error-text={
          gettext("That passkey couldn't be verified. Try again or use another method.")
        }
      >
      </p>
    </div>

    <p class="mt-6 text-center">
      <a href={~p"/sign-in"} class="link auth-muted">{gettext("Back to sign in")}</a>
    </p>
  </div>
</div>
