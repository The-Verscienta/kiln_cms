<Layouts.public locale_links={@locale_links} locale={@locale} current_org={@current_org}>
  <%!-- The article is in the record's language, matching `<html lang>`; the
        site chrome around it stays in the request's (#2465). --%>
  <BlockComponents.in_locale locale={@locale}>
    <article class="public-article prose max-w-none">
      <header class="public-masthead mb-6">
        <h1 class="public-title text-3xl font-bold tracking-tight">{@record.title}</h1>
        <p
          :if={byline?(assigns[:bylines], nil)}
          class="public-meta mt-2 text-sm text-base-content/70"
        >
          <.byline bylines={@bylines} />
        </p>
        <p
          :if={Map.get(@record, :excerpt)}
          class="public-lede mt-3 text-lg text-base-content/70"
        >
          {@record.excerpt}
        </p>
      </header>
      <div class="public-body space-y-4">
        <BlockComponents.render_block
          :for={block <- @blocks}
          block={block}
          variant={assigns[:experiment_variant]}
          image_sizes={image_sizes(@current_org)}
          locale={@locale}
        />
      </div>
    </article>
  </BlockComponents.in_locale>
</Layouts.public>
