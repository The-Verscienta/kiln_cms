# Copy to .env and adjust. Used by docker-compose and (optionally) local dev.
#
# On/off variables accept true/1/yes/on and false/0/no/off — trimmed and
# case-insensitive, so `TRUE` and `On` work. A blank `FOO=` counts as unset,
# not as false. Anything else is never interpreted: it keeps the default and
# warns on stderr, so a typo can no longer silently disable TLS to the database
# (#606/#607) — but equally, it cannot silently ENABLE an off-by-default flag,
# so check stderr on boot after setting one. See docs/environment-variables.md.

# --- Postgres (required) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kiln_cms_dev
POSTGRES_PORT=5432

# Phoenix/Ecto connection (used in prod via runtime.exs).
DATABASE_URL=ecto://postgres:postgres@localhost:5432/kiln_cms_dev

# --- Phoenix (required in prod) ---
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=
PHX_HOST=localhost
PORT=4000
# Extra origins allowed to open LiveView/channel sockets (comma-separated),
# for serving the app on more than one hostname. PHX_HOST is always allowed.
# CHECK_ORIGINS=cms.example.com,//staging.example.com
# Sites allowed to iframe an embeddable form (/forms/:slug/embed). Unset means
# same-origin only, so without it the Embed-tab snippet renders a blank iframe
# on any other site. `*` allows every site. See docs/forms.md.
# EMBED_ORIGINS=https://acme.com,https://blog.acme.com

# --- Dragonfly (optional — multi-node shared cache only, profile: cache) ---
DRAGONFLY_PORT=6379
# REDIS_URL=redis://localhost:6379

# --- Meilisearch (optional — profile: search) ---
MEILI_PORT=7700
MEILI_MASTER_KEY=masterKeyChangeMe

# --- MinIO / S3 (optional — profile: storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Object storage adapter (prod, runtime.exs): set S3_BUCKET to switch media
# blobs from local disk to the S3-compatible adapter. Works with AWS S3,
# Cloudflare R2, Backblaze B2, Wasabi, MinIO, etc.
# S3_BUCKET=kiln-media
# S3_PUBLIC_BASE_URL=https://cdn.example.com          # key is appended; include the bucket path
# AWS_ACCESS_KEY_ID=...                                 # provider access key (MinIO: root user above)
# AWS_SECRET_ACCESS_KEY=...                             # provider secret (MinIO: root password above)
# AWS_REGION=us-east-1                                  # R2: "auto"; B2/Wasabi/AWS: a real region
# S3_ACL=public_read                                    # optional; only if the bucket uses per-object ACLs
#
# Non-AWS providers also need the endpoint (S3_ENDPOINT_SCHEME defaults to https://,
# S3_ENDPOINT_PORT to 443). Pick one:
# MinIO (local dev):   S3_ENDPOINT_HOST=localhost  S3_ENDPOINT_SCHEME=http://  S3_ENDPOINT_PORT=9000
# Cloudflare R2:       S3_ENDPOINT_HOST=<accountid>.r2.cloudflarestorage.com
# Backblaze B2:        S3_ENDPOINT_HOST=s3.us-west-002.backblazeb2.com
# Wasabi:              S3_ENDPOINT_HOST=s3.us-east-1.wasabisys.com

# Extra origins allowed in the browser CSP's img-src (space-separated). Needed
# when media library files serve from an external CDN — without it the admin
# shows blank thumbnails for those images.
# CSP_IMG_SRC=https://imagedelivery.net

# --- Unsplash (optional — media library stock-photo search/import) ---
# Setting an access key (the Unsplash API "Access Key", not the secret key)
# enables the Unsplash tab in the media library.
# UNSPLASH_ACCESS_KEY=

# --- LLM (optional — AI assist, Stretch phase) ---
# AI_API_KEY=

# --- Tamper-evident history & content signing (optional — #356, #340) ---
# Every publish folds the document's version chain into a canonical hash and
# records it append-only. Without a signing key those anchors are stored
# UNSIGNED — still an integrity checksum, but the anchor row itself is no
# longer tamper-proof and the governance dashboard reports `unsigned` rather
# than `verified`. See docs/environment-variables.md.
#
# PKCS#1 RSA private key PEM ("BEGIN RSA PRIVATE KEY" — PKCS#8 is rejected):
#   openssl genrsa -traditional -out kiln-provenance.pem 2048
#
# PREFERRED: mount the key as a file and point at it by path. The key is a
# MULTI-LINE PEM and most .env parsers (docker-compose included) do not carry
# embedded newlines, so KILN_PROVENANCE_PRIVATE_KEY below is the fragile route.
# Set when present, this wins over KILN_PROVENANCE_PRIVATE_KEY.
# Never commit the key itself.
# KILN_PROVENANCE_KEY_FILE=/run/secrets/kiln-provenance.pem
#
# The same key inline, for a deployment whose secret store can hand over a
# multi-line value. Leave unset if you set KILN_PROVENANCE_KEY_FILE.
# KILN_PROVENANCE_PRIVATE_KEY=

# Public halves of keys that no longer sign but must still VERIFY, as a
# comma-separated list of PEM paths. Every manifest and history anchor records
# the key that signed it, so a rotation blinds everything signed before it until
# the outgoing key's public half is registered here. Register it BEFORE
# destroying the outgoing private half — the two are only interchangeable once
# this is set. Paths only: a public key is a multi-line PEM too.
#   openssl rsa -in old-kiln-provenance.pem -pubout -out /etc/kiln/keys/2025.pub.pem
# KILN_PROVENANCE_RETIRED_KEY_FILES=/etc/kiln/keys/2025.pub.pem,/etc/kiln/keys/2024.pub.pem

# Produce C2PA-style signed manifests for fired artifacts and serve the
# /api/provenance/* verification endpoints (#340). OFF by default — with this
# unset the endpoints 404 even when a signing key is configured, because the key
# alone only signs history anchors. Accepts true/1/yes/on and false/0/no/off
# (trimmed, case-insensitive); anything else keeps the configured default and
# warns. Ignored under MIX_ENV=test. See docs/provenance.md.
# KILN_PROVENANCE_ENABLED=true

# Anchor EVERY versioned write, not just publishes (#356's "sign every
# version"). Costs one signature and one history_anchors row per save — a
# regulated deployment wants this, a blog does not. Only a recognized spelling
# writes config (see the on/off note at the top of this file). The compiled
# default is OFF, so a typo here means per-write anchoring never switched on —
# the boot warning on stderr is your only signal. Ignored under MIX_ENV=test.
# Set the signing key above FIRST, or you pay the per-save cost and still get
# `unsigned` anchors — which now logs a warning on every anchor.
# KILN_AUDIT_ANCHOR_EVERY_WRITE=true
